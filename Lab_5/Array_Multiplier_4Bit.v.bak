module Array_Multiplier_4Bit(
   input [3:0]A,
   input [3:0]B,
   output [7:0]P
);
   wire [3:0] p [3:0];
   
   assign p[0] = A & {4{B[0]}};
   assign p[1] = A & {4{B[1]}};
   assign p[2] = A & {4{B[2]}};
   assign p[3] = A & {4{B[3]}};

   assign P = p[0] + (p[1] << 1) + (p[2] << 2) + (p[3] << 3);
endmodule

module hex_to_7seg (
   input [3:0] hex,
   output reg [6:0] segments
);
   always @(*) begin
      case (hex)
         4'h0: segments = 7'b1000000;
         4'h1: segments = 7'b1111001;
         4'h2: segments = 7'b0100100;
         4'h3: segments = 7'b0110000;
         4'h4: segments = 7'b0011001;
         4'h5: segments = 7'b0010010;
         4'h6: segments = 7'b0000010;
         4'h7: segments = 7'b1111000;
         4'h8: segments = 7'b0000000;
         4'h9: segments = 7'b0010000;
         4'hA: segments = 7'b0001000;
         4'hB: segments = 7'b0000011;
         4'hC: segments = 7'b1000110;
         4'hD: segments = 7'b0100001;
         4'hE: segments = 7'b0000110;
         4'hF: segments = 7'b0001110;
         default: segments = 7'b1111111;
      endcase
   end
endmodule

module Lab_Multiplier_Top (
   input [9:0] SW,
   output [6:0] HEX0,
   output [6:0] HEX1,
   output [6:0] HEX4,
   output [6:0] HEX5
);
   wire [3:0] A = SW[7:4];
   wire [3:0] B = SW[3:0];
   wire [7:0] P;

   array_multiplier_4x4 mult (
      .A(A),
      .B(B),
      .P(P)
   );

   hex_to_7seg seg_p0 (.hex(P[3:0]), .segments(HEX0));
   hex_to_7seg seg_p1 (.hex(P[7:4]), .segments(HEX1));
   hex_to_7seg seg_b  (.hex(B),      .segments(HEX4));
   hex_to_7seg seg_a  (.hex(A),      .segments(HEX5));
endmodule
endmodule