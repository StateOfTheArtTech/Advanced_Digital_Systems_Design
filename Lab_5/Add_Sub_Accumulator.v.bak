module Add_Sub_Accumulator(
   input [7:0]A,
   input clk,
   input sub;
   output reg [7:0]S,
   output reg overflow
);
	reg [7:0]in;
   wire [8:0]out;

   assign out =  in + S;

   always @(posedge clk) begin
      S <= out[7:0];
		if(~sub) begin
			in <= A;
		end else begin
			in <= (~A + 1'b0);
		end
			
      overflow <= out[8];
   end

endmodule