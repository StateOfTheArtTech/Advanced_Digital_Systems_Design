module p419(
	input w1,w2,w3, 
	output reg f
);
	always @({w1,w2,w3}) begin
		case ({w1,w2,w3})
			3'b000: f = 1'b0;
			3'b001: f = 1'b1;
			3'b010: f = 1'b1;
			3'b011: f = 1'b1;
			3'b100: f = 1'b0;
			3'b101: f = 1'b1;
			3'b110: f = 1'b1;
			3'b111: f = 1'b0;
			default: f = 1'b0;
		endcase
	end

endmodule

 