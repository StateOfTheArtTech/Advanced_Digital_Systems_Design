`timescale 1 ps/ 1 ps
module HW_2_vlg_vec_tst();
// constants                                           
// general purpose registers
reg b0;
reg b1;
reg b2;
// wires                                               
wire s0;
wire s1;

// assign statements (if any)                          
HW_2 i1 (
// port map - connection between master ports and signals/registers   
	.b0(b0),
	.b1(b1),
	.b2(b2),
	.s0(s0),
	.s1(s1)
);
initial 
begin 
#100000 $stop;
end 

// b0
always
begin
	b0 = 1'b0;
	b0 = #5000 1'b1;
	#5000;
end 

// b1
always
begin
	b1 = 1'b0;
	b1 = #10000 1'b1;
	#10000;
end 

// b2
initial
begin
	repeat(2)
	begin
		b2 = 1'b0;
		b2 = #20000 1'b1;
		# 20000;
	end
	b2 = 1'b0;
end 
endmodule

