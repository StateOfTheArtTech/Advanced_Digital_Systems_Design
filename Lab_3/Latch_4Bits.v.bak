module Latch_4Bits(
	En, [3:0]in, [3:0]out
);
	input En, in;
	output out;
	
	gated_D_latch l0(
		.Clk(En), .D(in[0]), .Q(out[0])
	);
	
	gated_D_latch l1(
		.Clk(En), .D(in[1]), .Q(out[1])
	);
	
	gated_D_latch l2(
		.Clk(En), .D(in[2]), .Q(out[2])
	);
	
	gated_D_latch l3(
		.Clk(En), .D(in[3]), .Q(out[3])
	);
	
	
	
endmodule

module gated_D_latch(
	Clk, D, Q
);
	input D, Clk;
	output reg Q;
	always @ (D, Clk) begin
		if (Clk) begin
			Q <= D;
		end
	end
endmodule
