module mux_4bit_2_1(
	input [3:0]s,
	input [3:0]x,
	input [3:0]y,
	output [3:0]m
);
	mux_2_1 mux0(.s(s[0]), .x(x[0]), .y(y[0]), .m(m[0]));
	mux_2_1 mux1(.s(s[1]), .x(x[1]), .y(y[1]), .m(m[1]));
	mux_2_1 mux2(.s(s[2]), .x(x[2]), .y(y[2]), .m(m[2]));
	mux_2_1 mux3(.s(s[3]), .x(x[3]), .y(y[3]), .m(m[3]));
endmodule 