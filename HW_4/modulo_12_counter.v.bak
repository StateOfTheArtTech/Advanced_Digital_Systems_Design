module modulo_12_counter (
    input wire clk,
    input wire reset,
    input wire ena,
    output reg [3:0] q
);

    always @(posedge clk) begin
        if (reset) begin
            q <= 4'b0000;
        end else if (ena) begin
            if (q == 4'd12)
                q <= 4'b0000;
            else
                q <= q + 1'b1;
        end
    end

endmodule